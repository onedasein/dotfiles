/* ~/.config/waybar/style.css
 * 胶囊风 + 渐变点缀，强调色跟 niri 焦点环一致：#b026ff（深紫）→ #7df9ff（浅青）
 */

* {
    font-family: "Firacode Nerd Font", "JetBrainsMono Nerd Font", "Noto Sans Symbols", "DejaVu Sans", monospace;
    font-size: 12px;
    min-height: 0;
}

window#waybar {
    /* background-color: rgba(30, 30, 46, 0.62); */
    background: transparent;
    background-image: linear-gradient(90deg, rgba(176, 38, 255, 0.18), rgba(125, 249, 255, 0.10));
    color: #cdd6f4;
    border-radius: 16px;
    border: 1px solid rgba(176, 38, 255, 0.40);
    padding: 0 6px;
}

/* 工作区：深色底胶囊，当前工作区用亮紫胶囊 */
#workspaces {
    background-color: rgba(17, 17, 27, 0.55);
    border-radius: 99px;
    margin: 4px 4px 4px 0;
    padding: 0 4px;
}

#workspaces button {
    padding: 0 10px;
    margin: 3px 2px;
    min-width: 10px;
    border-radius: 99px;
    border: none;
    background: transparent;
    color: #7f849c;
    transition: all 150ms ease;
}

#workspaces button:hover {
    background: rgba(125, 249, 255, 0.20);
    color: #cdd6f4;
}

#workspaces button.active {
    background: #b026ff;
    color: #f7f2ff;
    font-weight: 600;
}

#workspaces button.empty {
    color: #585b70;
}

#workspaces button.urgent {
    background: #f38ba8;
    color: #1e1e2e;
}

#window {
    padding: 0 10px;
    color: #a6adc8;
}

#clock {
    padding: 0 14px;
    color: #e6e0ff;
    font-weight: 600;
}

#battery,
#cpu,
#memory,
#pulseaudio,
#network,
#tray {
    padding: 0 10px;
    color: #bac2de;
}

#pulseaudio.muted {
    color: #f38ba8;
}

#network.disconnected {
    color: #f38ba8;
}

/* 电量：充电偏绿，20% 以下转黄，10% 以下转红 */
#battery.charging {
    color: #a6e3a1;
}

#battery.warning:not(.charging) {
    color: #f9e2af;
}

#battery.critical:not(.charging) {
    color: #f38ba8;
}

/* 工具提示也统一成胶囊风 */
tooltip {
    background: rgba(30, 30, 46, 0.96);
    border: 1px solid rgba(176, 38, 255, 0.45);
    border-radius: 10px;
}

tooltip label {
    color: #cdd6f4;
    padding: 4px;
}
