{
	"layer": "top", // Waybar at top layer
	"height": 28, // Waybar height (to be removed for auto height)
	"margin-top": 2,
	"margin-left": 4,
	"margin-right": 4,
	"spacing": 0, // Gaps between modules (4px)
	"modules-left": ["niri/workspaces"],
	"modules-center": ["clock"],
	// 本地适配：右栏去掉 custom/cash —— 它要调 ~/.cargo/bin/cash-rate-logger（本机没装），
	// 装着后把 "custom/cash" 加回下面数组即可。
	// 本地适配：cpu 槽位换成电池，右栏现在显示电池图标 + 电量百分比
	"modules-right": ["tray", "battery", "memory", "pulseaudio", "custom/gpu"],
	// custom/kbd
	// Modules configuration
	"niri/workspaces": {
		"all-outputs": true,
		"format": "{icon}",
		"format-icons": {
			"focused": "",
			"default": ""
		},
		"disable-click": true,
		"disable-markup": true
	},
	"clock": {
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format": "{:%a, %b %d, %Y  %H:%M:%S}",
		"interval":1,
		"calendar":{
			"mode":"year",
			"mode-mon-col":3,
			"weeks-pos":"left",
			"format":{
				"months":"<span color='#ffead3'><b>{}</b></span>",
				"days":"<span color='#ecc6d9'><b>{}</b></span>",
				"weeks":"<span color='#99ffdd'><b>W{}</b></span>",
				"weekdays":"<span color='#ffcc66'><b>{}</b></span>",
				"today":"<span color='#ff6699'><b>{}</b></span>"
			}
		},
		"actions":{
			"on-click":"shift_up",
			"on-click-right":"shift_down"
		}
	},
	"tray": {
		// "icon-size": 21,
		"spacing": 10
	},
	"battery": {
		"interval":5,
		"states":{
			"good": 95,
			"warning": 30,
			"critical": 15
		},
		// 本地适配：改成「电量% + 电池图标」；上游是剩余时间，插电时只剩一个插头图标，看不到电量
		"format": "{capacity}% {icon}",
		"format-charging": "{capacity}% 󰂄",
		"format-plugged": "{capacity}% {icon}",
		"format-alt": "{time} {icon}",
		"format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
	},
	// 本地适配：cpu 已从右栏移除（这个位置现在是电池）；想恢复就把 "cpu" 加回 modules-right
	"cpu": {
		"format": "{usage}% ",
		"tooltip": true
	},
	"memory": {
		"format": "{}% "
	},
	"pulseaudio": {
		//"scroll-step": 1,
		"format": "{volume}% {icon}",
		"format-bluetooth": "{volume}% {icon}",
		"format-bluetooth-muted": "{volume}% 󰝟 {icon}",
		"format-muted": "{volume}% 󰝟",
		"format-source": "{volume}% ",
		"format-source-muted": "",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": ["", "", ""]
		},
		"on-click": "pavucontrol"
	},
	"custom/cash": {
		"format":"{icon}",
		"format-icons":"",
		"tooltip":true,
		"interval": 1,
		"return-type": "json",
		"exec":"~/.cargo/bin/cash-rate-logger -c ~/.config/cash-rate-logger.toml --waybar"
		//"exec": "/tmp/a.sh"
	},
	// local: GPU mode switch (click -> gpu-menu)
	"custom/gpu": {
		"format": "{text}",
		"tooltip": true,
		"interval": 3,
		"return-type": "json",
		"exec": "gpu waybar",
		"on-click": "gpu-menu"
	},
	// local: keyboard backlight (click: toggle, right-click: off)
	"custom/kbd": {
		"format": "{text}",
		"tooltip": true,
		"interval": 5,
		"return-type": "json",
		"exec": "kbd waybar",
		"on-click": "kbd toggle",
		"on-click-right": "kbd off"
	}
}
