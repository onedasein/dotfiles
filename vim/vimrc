set nocompatible

" ---- 本地适配（上游没有这行；以后重新拉上游 vimrc 时记得保留）----
" 上游把 vimrc/syntax 放在 ~/.config/vim（= Ubuntu vim 默认 rtp 第一项），
" 但 vim-plug 本体 ~/.vim/autoload/plug.vim 和老插件目录在 ~/.vim，不在 rtp 里，
" 不加这行 plug#begin() 会报 E117: Unknown function: plug#begin。
set runtimepath+=~/.vim
" ---- 本地适配结束 ----

set showcmd
set nu rnu
set shiftwidth=4 tabstop=4 softtabstop=4
set autoindent
set shortmess-=S
set backupcopy=yes
autocmd TerminalOpen * setlocal nonu nornu
filetype on
filetype plugin on
filetype indent on
autocmd Filetype rust setlocal foldmethod=syntax
autocmd Filetype html,xml,css setlocal sw=2 ts=2 foldmethod=syntax
autocmd Filetype mediawiki setlocal nolinebreak
autocmd Filetype typst setlocal noet sw=2 ts=2 sts=2
autocmd Filetype rust setlocal noet sw=4 ts=4 sts=4
autocmd Filetype python,sage setlocal noet
autocmd Filetype markdown setlocal et sw=4 ts=4 sts=4
autocmd Filetype yaml setlocal et
autocmd Filetype javascript,typescript,typescriptreact,vue,astro setlocal sw=2 ts=2 sts=2
autocmd BufNewFile,BufRead *.wl set syntax=wl
autocmd BufNewFile,BufRead *.wls set syntax=wl
autocmd BufNewFile,BufRead *.mdx setfiletype markdown
" ---- 空花括号内回车展开为三行（C/Go 的 K&R 大括号风格）----
" 光标停在 { 与 } 之间时按回车，默认只拆出两行、光标还贴在右花括号前。
" 这里改成拆行后再用 <C-o>O 在中间开一行，变成三行且光标在中间行。
function! s:SmartCR() abort
  let l:line = getline('.')
  let l:i = col('.') - 1
  if l:i >= 1 && l:line[l:i - 1] ==# '{' && l:line[l:i] ==# '}'
    return "\<CR>\<C-o>O"
  endif
  return "\<CR>"
endfunction
augroup smart_cr_braces
  autocmd!
  autocmd FileType c,go inoremap <buffer><silent><expr> <CR> <SID>SmartCR()
augroup END
syntax on
" ---- 本地适配：配色（亮色 + Latte 米白背景）----
" Vim 9.1 自带 colors/catppuccin.vim（vim-runtime 包内，无需装插件），
" 它按 'background' 自动选 Mocha(dark) / Latte(light)。这里要亮色，用 Latte。
" Latte 自带底色就是 #eff1f5（冷调米白），比纯白柔和；这里仍显式覆盖一遍，
" 保证 colorscheme 被换掉或重载时也还是同一个背景色。
" termguicolors 让终端用真彩色取这套颜色；否则会退回 256 色近似值。
" 想换别家亮色，改下面 colorscheme 一行即可；米白覆盖那段保持不动也行。
set termguicolors
set background=light
colorscheme catppuccin
" 米白底覆盖（必须写在 colorscheme 之后才生效）：
highlight Normal guifg=#4c4f69 guibg=#ffffff ctermfg=235 ctermbg=255
highlight NormalFloat guifg=#4c4f69 guibg=#ffffff ctermfg=235 ctermbg=255
" Latte 的灰色系在浅底上对比度偏低，NonText/行号/折叠列都加深到 overlay 色。
highlight NonText guifg=#9ca0b0 guibg=#ffffff ctermfg=247 ctermbg=255
highlight EndOfBuffer guifg=#ffffff guibg=#ffffff ctermfg=231 ctermbg=255
highlight SignColumn guibg=#ffffff ctermbg=255
highlight FoldColumn guifg=#9ca0b0 guibg=#ffffff ctermfg=247 ctermbg=255
highlight LineNr guifg=#7c7f93 guibg=#ffffff ctermfg=243 ctermbg=255
highlight CursorLineNr guifg=#df8e1d guibg=#ffffff ctermfg=214 ctermbg=255
" 注释：Latte 的 #7c7f93 在米白底上只有 3.7:1，压到 overlay1 #6c6f85（4.9:1）
highlight Comment guifg=#6c6f85 ctermfg=243 gui=italic cterm=italic

" ---- 语法色加强 -------------------------------------------------------------
" Catppuccin Latte 是「柔和」取向的浅色盘，原始色在 #eff1f5 底上普遍只有 2~3:1
" （string 2.96、constant 2.44、type 2.31、preproc 2.20），看久了发淡。
" 这里保留色相、把明度压暗一档，文字组统一到 4.8~5.3:1。语句/关键字用的
" mauve #8839ef 本来就有 4.79，不动；oper 之外的 UI 色也不动。
highlight String     guifg=#307820 ctermfg=28
highlight Constant   guifg=#a04a0a ctermfg=130
highlight Number     guifg=#a04a0a ctermfg=130
highlight Float      guifg=#a04a0a ctermfg=130
highlight Function   guifg=#1a5cd8 ctermfg=26
highlight Title      guifg=#1a5cd8 ctermfg=26 gui=bold cterm=bold
highlight Directory  guifg=#1a5cd8 ctermfg=26
highlight Type       guifg=#935e13 ctermfg=94
highlight PreProc    guifg=#b53b93 ctermfg=127
highlight Special    guifg=#b53b93 ctermfg=127
highlight Exception  guifg=#935e13 ctermfg=94
highlight Identifier guifg=#b04545 ctermfg=131
highlight Todo       guifg=#b04545 ctermfg=131 gui=bold cterm=bold
highlight Operator   guifg=#0b6bb0 ctermfg=25
highlight MatchParen guifg=#a04a0a ctermfg=130 gui=bold cterm=bold
highlight CursorLineNr guifg=#935e13 guibg=#eff1f5 ctermfg=94 ctermbg=255
" Catppuccin 自带 CursorLine 与 markdown* 的配色，保持原样，无需覆盖。
set cursorline
" ---- 本地适配结束 ----
set listchars=tab:→\ ,nbsp:␣,trail:•,extends:⟩,precedes:⟨
set list
set incsearch showmode showmatch hlsearch
